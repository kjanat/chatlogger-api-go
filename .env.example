# ChatLogger API - Environment Configuration Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:password@localhost:5432/chatlogger?sslmode=disable

# Test Database (for running tests)
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/chatlogger_test?sslmode=disable

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection (for background jobs)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server Port
PORT=8080

# Gin Mode (debug, release, test)
GIN_MODE=debug

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Secret Key (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Token Expiration (in hours)
JWT_EXPIRATION_HOURS=24

# API Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# =============================================================================
# EXPORT CONFIGURATION
# =============================================================================

# Directory for storing export files
EXPORT_DIR=./exports

# Maximum export file size (in MB)
MAX_EXPORT_SIZE_MB=100

# Export cleanup interval (in hours)
EXPORT_CLEANUP_INTERVAL_HOURS=24

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Log Format (json, text)
LOG_FORMAT=text

# Log Output (stdout, file)
LOG_OUTPUT=stdout

# Log File Path (if LOG_OUTPUT=file)
LOG_FILE_PATH=./logs/app.log

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug endpoints (set to false in production)
DEBUG_ENDPOINTS=true

# Enable request logging
REQUEST_LOGGING=true

# Enable SQL query logging
SQL_LOGGING=false

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Health check interval (in seconds)
HEALTH_CHECK_INTERVAL=30

# Metrics collection enabled
METRICS_ENABLED=true

# Tracing enabled (for development)
TRACING_ENABLED=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Database connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# Worker concurrency
WORKER_CONCURRENCY=10

# Request timeout (in seconds)
REQUEST_TIMEOUT=30

# =============================================================================
# SECURITY HEADERS
# =============================================================================

# Content Security Policy
CSP_HEADER="default-src 'self'"

# Additional security headers
SECURITY_HEADERS_ENABLED=true
EOF < /dev/null