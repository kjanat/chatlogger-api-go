# ChatLogger API Go - Git Ignore Rules

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.txt
coverage.html

# Dependency directories
vendor/

# Temporary files
*.tmp
.temp/
tmp/

# Go workspace file
go.work
go.work.sum

# Environment/credential files
.env
.env.local
.env.*.local
cosign.key
*.pem
*.key
*.crt

# Log files
*.log
logs/

# Database files
*.db
*.sqlite
*.sqlite3

# Export/upload directories
exports/
uploads/

# GitHub secret scanning
.cache_ggshield

# Backup and temporary files
*?copy.*
*?old.*
*.backup
*.bak

# Documentation build artifacts (keep source docs)
docs/site/
site/

# API documentation generated files
docs/swagger.json
docs/swagger.yaml

# Benchmark and profiling results
benchmark_results.txt
*.bench
*.prof
*.trace

# Editor and IDE files
.idea/
.vs/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Development overrides
docker-compose.override.yml
.env.override

# Testing artifacts
.testcache/
testdata/output/
